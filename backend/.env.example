PORT=5000
NODE_ENV=development

# MongoDB connection string. Local example, or use a MongoDB Atlas URI.
MONGO_URI=mongodb://127.0.0.1:27017/mindspace

# Used to sign login tokens. Set this to a long random string in production.
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# The frontend's URL, for CORS.
CLIENT_URL=http://localhost:5173

# No AI API key needed. Mood/music suggestions come from a small neural
# network trained from scratch on-device (see backend/ml/) — no external
# calls, no cost, works fully offline once installed.
